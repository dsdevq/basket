{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "basket": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "bk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/basket"
            },
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {"glob": "**/*", "input": "public"},
              {"glob": "*", "input": "node_modules/@lifekit-hq/tokens/brand/dist/bk"}
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/@lifekit-hq/tokens/fonts.css",
              "node_modules/@lifekit-hq/tokens/theme.css",
              "node_modules/@lifekit-hq/tokens/presets/lifekit.css",
              "src/seeds/basket.css",
              "node_modules/@lifekit-hq/tokens/base.css"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.45mb",
                  "maximumError": "1.6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "basket:build:production"
            },
            "development": {
              "buildTarget": "basket:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "basket:build:development",
            "setupFiles": ["src/test-setup.ts"],
            "coverageExclude": ["src/main.ts", "src/test-setup.ts"]
          },
          "configurations": {
            "ci": {
              "watch": false,
              "coverage": true
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@schematics/angular"],
    "packageManager": "npm"
  }
}
