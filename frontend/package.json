{
  "name": "basket-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test basket --configuration ci",
    "e2e": "playwright test",
    "lint": "lifekit-theme-sync --check --csp ../backend/src/Basket.Api/appsettings.json && node scripts/build-seed.mjs --check && ng lint --max-warnings 0",
    "sync:theme": "lifekit-theme-sync --csp ../backend/src/Basket.Api/appsettings.json",
    "build:seed": "node scripts/build-seed.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@lifekit-hq/charts-core": "^4.3.0",
    "@lifekit-hq/core": "^4.3.0",
    "@lifekit-hq/elements": "^4.3.0",
    "@lifekit-hq/tokens": "^4.3.0",
    "@lifekit-hq/ui": "^4.3.0",
    "@ngrx/signals": "^22.0.1",
    "chart.js": "^4.5.1",
    "deep-chat": "^2.5.0",
    "lit": "^3.3.3",
    "lucide-angular": "^1.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^9.39.4",
    "@lifekit-hq/config": "^4.3.0",
    "@playwright/test": "^1.64.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^25.5.0",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
