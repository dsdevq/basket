# Copy to ~/.config/basket/env on the VPS (outside any checkout; never in git), fill in, chmod 600.
# docker/.env also works for local runs and is git-ignored. See docs/vps-setup.md.

# The public address of the app, exactly as the browser sees it (scheme + host + Funnel port, no path).
# The passkey relying-party id is this host; the Origin allow-list is this value.
PUBLIC_ORIGIN=https://lifekit-vps.tail1cb676.ts.net:10000

# Database password: hex keeps it safe inside the connection string (openssl rand -hex 24).
POSTGRES_PASSWORD=

# One-time owner sign-up secret, at least 32 characters (openssl rand -base64 33 | tr '+/' '-_' | tr -d '=').
# While no user exists, https://<host>:10000/join#<this token> lets the first person register as owner.
# After the owner exists the value is inert; rotate or delete it then.
BOOTSTRAP_TOKEN=
