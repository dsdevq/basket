# The secrets live in docker/.env.sops (SOPS + age, committed encrypted); this file documents the values it holds.
# For a local run, copy it to docker/.env (git-ignored). docs/vps-setup.md says how the encrypted file is made and edited.

# The public address of the app, exactly as the browser sees it (scheme + host + Funnel port, no path).
# The passkey relying-party id is this host; the Origin allow-list is this value.
PUBLIC_ORIGIN=https://lifekit-vps.tail1cb676.ts.net:10000

# Database password: hex keeps it safe inside the connection string (openssl rand -hex 24).
POSTGRES_PASSWORD=

# One-time owner sign-up secret, at least 32 characters (openssl rand -base64 33 | tr '+/' '-_' | tr -d '=').
# While no user exists, https://<host>:10000/join#<this token> lets the first person register as owner.
# After the owner exists the value is inert; rotate or delete it then.
BOOTSTRAP_TOKEN=

# Optional: accept the fleet's machine identity (the `fleet-agent` application in the owner's Logto) on the price
# ingest and the product catalog. Neither value is a secret; leave both empty to keep the path off.
# FLEET_AGENT_AUTHORITY is the issuer the tokens carry (https://<host>:3001/oidc). FLEET_AGENT_BACKCHANNEL_AUTHORITY is
# an address the container can reach it on: the app joins the external Docker network `identity-oidc` (see the compose
# file), so on the VPS set it to http://logto:3001/oidc. Leave it empty only if the issuer's own address is reachable.
# To turn the path off again, empty both and redeploy.
FLEET_AGENT_AUTHORITY=
FLEET_AGENT_BACKCHANNEL_AUTHORITY=

# Optional: let people sign in through the org identity provider (the owner's Logto), as finance-sentry does. Leave all five
# empty to keep sign-in passkey-only. The app is its own Logto client ("basket", role `basket`), registered with the redirect
# URI <AUTH_OIDC_PUBLIC_BASE_URL>/api/auth/oidc/signin and the post sign-out URI <AUTH_OIDC_PUBLIC_BASE_URL>/sign-in?info=signed_out.
# AUTH_OIDC_AUTHORITY is the issuer (https://<host>:3001/oidc, the same value as FLEET_AGENT_AUTHORITY); the backchannel is
# http://logto:3001/oidc on the VPS. AUTH_OIDC_CLIENT_SECRET is a secret: generate it with the Logto admin script, keep it
# here (mode 600) and nowhere else. AUTH_OIDC_PUBLIC_BASE_URL is the address the browser opens, the same as PUBLIC_ORIGIN.
AUTH_OIDC_AUTHORITY=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_PUBLIC_BASE_URL=
AUTH_OIDC_BACKCHANNEL_AUTHORITY=
