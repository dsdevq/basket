# Copy to .env.local (ignored by git) or export these.
# Both addresses are the tailnet https ones: the PC reaches them with no tunnel while Tailscale is up.
BASKET_API_ORIGIN=https://basket.example.com

# Preferred: the fleet identity (OAuth client credentials). The page list then comes from basket's catalog.
BASKET_FLEET_CLIENT_ID=
BASKET_FLEET_CLIENT_SECRET=
# The issuer Logto stamps into its tokens, character for character (`npm run check` shows whether it matches).
BASKET_FLEET_ISSUER=https://<vps>.<tailnet>.ts.net:3001/oidc

# Or: the token made in basket, Settings > Workspace > Price reader (the page list is then urls.local.json).
# BASKET_INGEST_TOKEN=bsk_...
